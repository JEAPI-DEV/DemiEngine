{
  "format_version": 1,
  "gaps": [
    {
      "id": "runtime-object-model",
      "phase": 1,
      "status": "open",
      "summary": "Runtime component creation and mutation are not fully reflection-driven."
    },
    {
      "id": "runtime-prefab-scene-flow",
      "phase": 2,
      "status": "open",
      "summary": "Runtime prefabs, additive scenes, and explicit resource lifetimes are incomplete."
    },
    {
      "id": "cross-platform-input",
      "phase": 3,
      "status": "open",
      "summary": "Gamepad, multi-touch, gestures, rebinding, and safe-area services are incomplete."
    },
    {
      "id": "production-2d",
      "phase": 4,
      "status": "open",
      "summary": "Common 2D triggers, joints, particles, and presentation primitives are incomplete."
    },
    {
      "id": "lightweight-3d",
      "phase": 5,
      "status": "open",
      "summary": "Character controllers, dynamic rigidbodies, triggers, and common 3D lights are incomplete."
    },
    {
      "id": "dynamic-ui",
      "phase": 8,
      "status": "open",
      "summary": "Runtime-created UI trees, dynamic lists, safe areas, and world-space UI are incomplete."
    },
    {
      "id": "network-session-completion",
      "phase": 9,
      "status": "open",
      "summary": "Replicated gameplay state, RPC conventions, late join, and disconnect repair need a higher-level contract."
    },
    {
      "id": "android-shipping",
      "phase": 12,
      "status": "open",
      "summary": "Release signing, lifecycle, metadata, permissions, and device validation are not yet a finished path."
    }
  ],
  "gates": [
    {
