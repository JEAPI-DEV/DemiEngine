{
  "format_version": 1,
  "id": "ui-prefab://orbit/dropdown",
  "parameters": {
    "accent": {
      "type": "string",
      "default": "#FFB66B"
    },
    "background": {
      "type": "string",
      "default": "#101822"
    },
    "label1": {
      "type": "string",
      "default": "Low"
    },
    "label2": {
      "type": "string",
      "default": "Balanced"
    },
    "label3": {
      "type": "string",
      "default": "Ultra"
    },
    "muted": {
      "type": "string",
      "default": "#A3B5C5"
    },
    "raised": {
      "type": "string",
      "default": "#263748"
    },
    "size": {
      "type": "array",
      "default": [
        280,
        44
      ]
    },
    "stroke": {
      "type": "string",
      "default": "#3B5166"
    },
    "surface": {
      "type": "string",
      "default": "#1B2735"
    },
    "text": {
      "type": "string",
      "default": "#EEF4FA"
    }
  },
  "root": {
    "id": "dropdown",
    "type": "container",
    "size": "${size}",
    "children": [
      {
        "id": "trigger",
        "type": "button",
        "dock": "fill",
        "text": "${label2}",
        "font_size": 16,
        "background_color": "${background}",
        "hover_color": "${raised}",
        "text_color": "${text}",
        "color": "${accent}",
        "border_color": "${stroke}",
        "border_width": 1,
        "corner_radius": 9
      },
      {
        "id": "arrow",
        "type": "image",
        "anchor_min": [
          1,
          0.5
        ],
        "anchor_max": [
          1,
          0.5
        ],
        "at": [
          -30,
          -9
        ],
        "size": [
          18,
          18
        ],
        "texture": "asset://orbit/icons/chevron-down",
        "color": "${muted}",
        "accessibility_hidden": true
      },
      {
        "id": "menu",
        "type": "panel",
        "anchor_max": [
          1,
          0
        ],
        "position": [
          0,
          48
        ],
        "size": [
          0,
          142
        ],
        "pad": 6,
        "stack": "column",
        "gap": 2,
        "background_color": "${surface}",
        "border_color": "${stroke}",
        "border_width": 1,
        "corner_radius": 10,
        "visible": false,
        "layer": 200,
        "children": [
          {
            "id": "option1",
            "type": "button",
            "size": [
              0,
              42
            ],
            "text": "${label1}",
            "action": "",
            "disabled": false,
            "corner_radius": 6,
            "font_size": 16,
            "text_color": "${text}",
            "background_color": "${raised}",
            "hover_color": "${stroke}",
            "border_color": "${stroke}",
            "border_width": 0,
            "color": "${accent}",
            "layer": 201,
            "anchor_min": [
              0,
              0
            ],
            "anchor_max": [
              1,
              0
            ]
          },
          {
            "id": "option2",
            "type": "button",
            "size": [
              0,
              42
            ],
            "text": "${label2}",
            "action": "",
            "disabled": false,
            "corner_radius": 6,
            "font_size": 16,
            "text_color": "${text}",
            "background_color": "${raised}",
            "hover_color": "${stroke}",
            "border_color": "${stroke}",
            "border_width": 0,
            "color": "${accent}",
            "layer": 201,
            "anchor_min": [
              0,
              0
            ],
            "anchor_max": [
              1,
              0
            ]
          },
          {
            "id": "option3",
            "type": "button",
            "size": [
              0,
              42
            ],
            "text": "${label3}",
            "action": "",
            "disabled": false,
            "corner_radius": 6,
            "font_size": 16,
            "text_color": "${text}",
            "background_color": "${raised}",
            "hover_color": "${stroke}",
            "border_color": "${stroke}",
            "border_width": 0,
            "color": "${accent}",
            "layer": 201,
            "anchor_min": [
              0,
              0
            ],
            "anchor_max": [
              1,
              0
            ]
          }
        ],
        "alignment": "stretch"
      }
    ]
  }
}
