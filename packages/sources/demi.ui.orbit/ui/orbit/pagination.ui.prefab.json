{
  "format_version": 1,
  "id": "ui-prefab://orbit/pagination",
  "parameters": {
    "accent": {
      "type": "string",
      "default": "#FFB66B"
    },
    "raised": {
      "type": "string",
      "default": "#263748"
    },
    "size": {
      "type": "array",
      "default": [
        280,
        40
      ]
    },
    "stroke": {
      "type": "string",
      "default": "#3B5166"
    },
    "text": {
      "type": "string",
      "default": "#EEF4FA"
    }
  },
  "root": {
    "id": "pagination",
    "type": "container",
    "size": "${size}",
    "stack": "grid",
    "columns": 5,
    "gap": 6,
    "children": [
      {
        "id": "previous",
        "type": "button",
        "size": [
          0,
          40
        ],
        "text": "<",
        "action": "",
        "disabled": false,
        "corner_radius": 9,
        "font_size": 16,
        "text_color": "${text}",
        "background_color": "${raised}",
        "hover_color": "${stroke}",
        "border_color": "${stroke}",
        "border_width": 1,
        "color": "${accent}",
        "anchor_min": [
          0,
          0
        ],
        "anchor_max": [
          1,
          0
        ]
      },
      {
        "id": "page1",
        "type": "button",
        "size": [
          0,
          40
        ],
        "text": "1",
        "action": "",
        "disabled": false,
        "corner_radius": 9,
        "font_size": 16,
        "text_color": "${text}",
        "background_color": "${raised}",
        "hover_color": "${stroke}",
        "border_color": "${stroke}",
        "border_width": 1,
        "color": "${accent}",
        "anchor_min": [
          0,
          0
        ],
        "anchor_max": [
          1,
          0
        ]
      },
      {
        "id": "page2",
        "type": "button",
        "size": [
          0,
          40
        ],
        "text": "2",
        "action": "",
        "disabled": false,
        "corner_radius": 9,
        "font_size": 16,
        "text_color": "${text}",
        "background_color": "${raised}",
        "hover_color": "${stroke}",
        "border_color": "${stroke}",
        "border_width": 1,
        "color": "${accent}",
        "anchor_min": [
          0,
          0
        ],
        "anchor_max": [
          1,
          0
        ]
      },
      {
        "id": "page3",
        "type": "button",
        "size": [
          0,
          40
        ],
        "text": "3",
        "action": "",
        "disabled": false,
        "corner_radius": 9,
        "font_size": 16,
        "text_color": "${text}",
        "background_color": "${raised}",
        "hover_color": "${stroke}",
        "border_color": "${stroke}",
        "border_width": 1,
        "color": "${accent}",
        "anchor_min": [
          0,
          0
        ],
        "anchor_max": [
          1,
          0
        ]
      },
      {
        "id": "next",
        "type": "button",
        "size": [
          0,
          40
        ],
        "text": ">",
        "action": "",
        "disabled": false,
        "corner_radius": 9,
        "font_size": 16,
        "text_color": "${text}",
        "background_color": "${raised}",
        "hover_color": "${stroke}",
        "border_color": "${stroke}",
        "border_width": 1,
        "color": "${accent}",
        "anchor_min": [
          0,
          0
        ],
        "anchor_max": [
          1,
          0
        ]
      }
    ]
  }
}
