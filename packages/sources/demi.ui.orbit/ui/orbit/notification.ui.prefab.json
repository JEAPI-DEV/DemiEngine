{
  "format_version": 1,
  "id": "ui-prefab://orbit/notification",
  "parameters": {
    "accent": {
      "type": "string",
      "default": "#FFB66B"
    },
    "message": {
      "type": "string",
      "default": "Your settings are ready for the next mission."
    },
    "muted": {
      "type": "string",
      "default": "#A3B5C5"
    },
    "stroke": {
      "type": "string",
      "default": "#3B5166"
    },
    "surface": {
      "type": "string",
      "default": "#1B2735"
    },
    "text": {
      "type": "string",
      "default": "#EEF4FA"
    },
    "title": {
      "type": "string",
      "default": "Changes saved"
    }
  },
  "root": {
    "id": "notification",
    "type": "panel",
    "size": [
      380,
      130
    ],
    "background_color": "${surface}",
    "border_color": "${stroke}",
    "border_width": 1,
    "corner_radius": 14,
    "children": [
      {
        "id": "header",
        "type": "container",
        "dock": "top",
        "size": [
          0,
          32
        ],
        "margin": [
          20,
          16,
          20,
          0
        ],
        "children": [
          {
            "id": "rail",
            "type": "panel",
            "dock": "left",
            "size": [
              3,
              0
            ],
            "margin": [
              0,
              7,
              0,
              7
            ],
            "background_color": "${accent}"
          },
          {
            "id": "title",
            "type": "label",
            "dock": "fill",
            "margin": [
              16,
              0,
              40,
              0
            ],
            "text": "${title}",
            "font_size": 20,
            "text_color": "${text}",
            "text_vertical_alignment": "center"
          },
          {
            "id": "close",
            "prefab": "ui-prefab://orbit/icon-button",
            "arguments": {
              "accent": "${accent}",
              "stroke": "${stroke}",
              "text": "${text}",
              "label": "Close notification",
              "size": [
                32,
                32
              ],
              "texture": "asset://orbit/icons/close"
            },
            "overrides": {
              "$root": {
                "dock": "right"
              }
            }
          }
        ]
      },
      {
        "id": "body",
        "type": "container",
        "dock": "fill",
        "margin": [
          20,
          64,
          20,
          20
        ],
        "children": [
          {
            "id": "message",
            "type": "label",
            "text": "${message}",
            "at": [
              0,
              0
            ],
            "size": [
              280,
              42
            ],
            "text_color": "${muted}",
            "font_size": 14,
            "text_vertical_alignment": "center"
          }
        ]
      }
    ]
  }
}
