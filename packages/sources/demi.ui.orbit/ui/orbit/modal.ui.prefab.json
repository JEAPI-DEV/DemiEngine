{
  "format_version": 1,
  "id": "ui-prefab://orbit/modal",
  "parameters": {
    "accent": {
      "type": "string",
      "default": "#FFB66B"
    },
    "accent_hover": {
      "type": "string",
      "default": "#FFD09A"
    },
    "cancel_action": {
      "type": "string",
      "default": "cancel"
    },
    "confirm_action": {
      "type": "string",
      "default": "confirm"
    },
    "message": {
      "type": "string",
      "default": "You can cancel and return safely."
    },
    "muted": {
      "type": "string",
      "default": "#A3B5C5"
    },
    "on_accent": {
      "type": "string",
      "default": "#19232F"
    },
    "raised": {
      "type": "string",
      "default": "#263748"
    },
    "stroke": {
      "type": "string",
      "default": "#3B5166"
    },
    "surface": {
      "type": "string",
      "default": "#1B2735"
    },
    "text": {
      "type": "string",
      "default": "#EEF4FA"
    },
    "title": {
      "type": "string",
      "default": "Confirm your choice"
    }
  },
  "root": {
    "id": "modal",
    "type": "modal",
    "dock": "fill",
    "visible": false,
    "layer": 400,
    "respect_safe_area": false,
    "background_color": "#000000A8",
    "children": [
      {
        "id": "window",
        "type": "panel",
        "size": [
          400,
          240
        ],
        "background_color": "${surface}",
        "border_color": "${stroke}",
        "border_width": 1,
        "corner_radius": 14,
        "children": [
          {
            "id": "header",
            "type": "container",
            "dock": "top",
            "size": [
              0,
              32
            ],
            "margin": [
              20,
              16,
              20,
              0
            ],
            "children": [
              {
                "id": "rail",
                "type": "panel",
                "dock": "left",
                "size": [
                  3,
                  0
                ],
                "margin": [
                  0,
                  7,
                  0,
                  7
                ],
                "background_color": "${accent}"
              },
              {
                "id": "title",
                "type": "label",
                "dock": "fill",
                "margin": [
                  16,
                  0,
                  0,
                  0
                ],
                "text": "${title}",
                "font_size": 20,
                "text_color": "${text}",
                "text_vertical_alignment": "center"
              }
            ]
          },
          {
            "id": "body",
            "type": "container",
            "dock": "fill",
            "margin": [
              20,
              64,
              20,
              20
            ],
            "children": [
              {
                "id": "message",
                "type": "text",
                "text": "${message}",
                "dock": "top",
                "size": [
                  0,
                  74
                ],
                "font_size": 16,
                "text_color": "${muted}",
                "text_wrap": "word"
              },
              {
                "id": "cancel",
                "prefab": "ui-prefab://orbit/button-secondary",
                "arguments": {
                  "accent": "${accent}",
                  "raised": "${raised}",
                  "stroke": "${stroke}",
                  "text": "${text}",
                  "label": "Cancel",
                  "action": "${cancel_action}",
                  "size": [
                    164,
                    44
                  ]
                },
                "overrides": {
                  "$root": {
                    "at": [
                      0,
                      100
                    ]
                  }
                }
              },
              {
                "id": "confirm",
                "prefab": "ui-prefab://orbit/button-primary",
                "arguments": {
                  "accent": "${accent}",
                  "accent_hover": "${accent_hover}",
                  "on_accent": "${on_accent}",
                  "stroke": "${stroke}",
                  "label": "Confirm",
                  "action": "${confirm_action}",
                  "size": [
                    184,
                    44
                  ]
                },
                "overrides": {
                  "$root": {
                    "at": [
                      176,
                      100
                    ]
                  }
                }
              }
            ]
          }
        ],
        "dock": "center",
        "layer": 401
      }
    ]
  }
}
