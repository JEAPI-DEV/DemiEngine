{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demiengine.local/schemas/scene.schema.json",
  "title": "DemiEngine Scene",
  "type": "object",
  "required": [
    "format_version",
    "id",
    "entities"
  ],
  "additionalProperties": true,
  "properties": {
    "prefab_origins": {
      "$ref": "#/properties/instances",
      "description": "Cooked scene instance ownership retained after entity expansion."
    },
    "format_version": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^scene://"
    },
    "name": {
      "type": "string"
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "anyOf": [{ "required": ["components"] }, { "required": ["prefab"] }],
        "properties": {
          "children": {
            "type": "array",
            "items": { "$ref": "#/properties/entities/items" },
            "description": "Local child entities; transform parent is inferred without changing stable IDs."
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "persistent": {
            "type": "boolean",
            "default": false
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "layer": {
            "type": "string"
          },
          "prefab": { "type": "string", "pattern": "^prefab://" },
          "entity_ids": { "$ref": "#/properties/instances/items/properties/entity_ids" },
          "overrides": { "type": "object" },
          "components": {
            "$ref": "components.schema.json"
          }
        }
      }
    },
    "instances": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "prefab"],
        "properties": {
          "id": { "type": "string" },
          "prefab": { "type": "string", "pattern": "^prefab://" },
          "entity_ids": { "type": "object", "propertyNames": { "minLength": 1 }, "additionalProperties": { "type": "string", "minLength": 1 }, "description": "Prefab-local expanded IDs mapped to stable IDs in the owning document. Destinations must remain unique." },
          "overrides": { "type": "object" }
        }
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "scale": {
            "type": "number"
          },
          "font_size": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}
