{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demiengine.local/schemas/hud.schema.json",
  "title": "DemiEngine HUD",
  "type": "object",
  "required": ["format_version"],
  "anyOf": [
    {"required": ["root"]},
    {"required": ["elements"]}
  ],
  "properties": {
    "format_version": {"type": "integer", "minimum": 1},
    "canvas_size": {"$ref": "#/$defs/vec2"},
    "theme": {"type": "string"},
    "localization_file": {"type": "string"},
    "styles": {"type": "object"},
    "localization": {"type": "object", "additionalProperties": {"type": "string"}},
    "action_map": {"type": "object", "additionalProperties": {"type": "string"}},
    "action_effects": {"type": "object"},
    "root": {"$ref": "#/$defs/node"},
    "elements": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "vec2": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}],
      "minItems": 2,
      "maxItems": 2
    },
    "color": {
      "anyOf": [
        {
          "type": "array",
          "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}],
          "minItems": 4,
          "maxItems": 4
        },
        {"type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"}
      ]
    },
    "insets": {
      "anyOf": [
        {"type": "number"},
        {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}], "minItems": 4, "maxItems": 4}
      ]
    },
    "node": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "prefab": {"type": "string", "pattern": "^ui-prefab://"},
        "arguments": {"type": "object"},
        "overrides": {"type": "object"},
        "type": {"enum": ["container", "panel", "label", "text", "image", "button", "toggle", "slider", "text_input", "scroll", "list", "progress", "modal", "virtual_button", "virtual_stick"]},
        "children": {"type": "array", "items": {"$ref": "#/$defs/node"}},
        "dock": {"enum": ["fill", "top", "bottom", "left", "right", "center"]},
        "stack": {"enum": ["row", "column", "grid"]},
        "at": {"$ref": "#/$defs/vec2"},
        "pad": {"$ref": "#/$defs/insets"},
        "padding": {"$ref": "#/$defs/insets"},
        "margin": {"$ref": "#/$defs/insets"},
        "gap": {"type": "number", "minimum": 0},
        "color": {"$ref": "#/$defs/color"},
        "background_color": {"$ref": "#/$defs/color"},
        "border_color": {"$ref": "#/$defs/color"},
        "hover_color": {"$ref": "#/$defs/color"},
        "text_color": {"$ref": "#/$defs/color"},
        "font_size": {"type": "number", "minimum": 1},
        "layout": {"enum": ["row", "column", "grid"]},
        "alignment": {"enum": ["start", "center", "end", "stretch"]},
        "position": {"$ref": "#/$defs/vec2"},
        "size": {"$ref": "#/$defs/vec2"},
        "anchor_min": {"$ref": "#/$defs/vec2"},
        "anchor_max": {"$ref": "#/$defs/vec2"},
        "min_size": {"$ref": "#/$defs/vec2"},
        "max_size": {"$ref": "#/$defs/vec2"},
        "disabled": {"type": "boolean"},
        "visible": {"type": "boolean"},
        "accessibility_label": {"type": "string"},
        "accessibility_description": {"type": "string"},
        "accessibility_hidden": {"type": "boolean"},
        "respect_safe_area": {"type": "boolean"},
        "action": {"type": "string"},
        "font": {"type": "string", "pattern": "^asset://"},
        "control": {"type": "string", "minLength": 1},
        "deadzone": {"type": "number", "minimum": 0, "maximum": 0.99},
        "placeholder": {"type": "string"},
        "placeholder_localization_key": {"type": "string"}
      }
    }
  }
}
