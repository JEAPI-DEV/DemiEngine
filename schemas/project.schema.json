{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demiengine.local/schemas/project.schema.json",
  "title": "DemiEngine Project",
  "type": "object",
  "required": ["format_version", "name", "scenes"],
  "additionalProperties": true,
  "properties": {
    "format_version": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "package_registry": {
      "type": "string",
      "minLength": 1
    },
    "network_contract": {
      "type": "string",
      "pattern": "^asset://"
    },
    "assets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(asset|asset-group)://.+"
      }
    },
    "packages": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9](?:[a-z0-9_-]|\\.(?=[a-z0-9_-]))*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "main_scene": {
      "type": "string",
      "pattern": "^scene://"
    },
    "input": {
      "type": "object",
      "properties": {
        "actions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["type", "context", "bindings"],
            "additionalProperties": false,
            "properties": {
              "type": {"enum": ["button", "axis1d", "vector2"]},
              "context": {"type": "string", "minLength": 1},
              "player": {"type": "integer", "minimum": 0},
              "bindings": {"$ref": "#/$defs/input_bindings"}
            }
          }
        }
      }
    },
    "physics": {
      "type": "object",
      "properties": {
        "layers": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "simulation": {
      "type": "object",
      "properties": {
        "fixed_timestep": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 1.0,
          "default": 0.016666667
        },
        "random_seed": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vsync": { "type": "boolean", "default": true }
      }
    },
    "performance_budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maximum_frame_ms": { "type": "number", "exclusiveMinimum": 0 },
        "maximum_draw_calls": { "type": "integer", "minimum": 1 },
        "maximum_resident_assets": { "type": "integer", "minimum": 1 },
        "maximum_visible_instances": { "type": "integer", "minimum": 1 },
        "maximum_unique_meshes": { "type": "integer", "minimum": 1 },
        "maximum_triangles": { "type": "integer", "minimum": 1 },
        "maximum_texture_memory_mb": { "type": "integer", "minimum": 1 },
        "maximum_lights": { "type": "integer", "minimum": 1 },
        "maximum_shadow_lights": { "type": "integer", "minimum": 1 },
        "maximum_transparent_draws": { "type": "integer", "minimum": 1 }
      }
    },
    "debug": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "colliders": { "type": "boolean", "default": false },
        "contacts": { "type": "boolean", "default": false },
        "grid": { "type": "boolean", "default": false },
        "entity_ids": { "type": "boolean", "default": false },
        "draw_order": { "type": "boolean", "default": false },
        "ui_bounds": { "type": "boolean", "default": false },
        "profiler_hud": { "type": "boolean", "default": false }
      }
    },
    "build": {
      "type": "object",
      "required": ["application_id"],
      "additionalProperties": false,
      "properties": {
        "application_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
        },
        "display_name": {"type": "string", "minLength": 1},
        "executable_name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "version_name": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "version_code": {"type": "integer", "minimum": 1},
        "icon": {"type": "string", "pattern": "^asset://"},
        "splash": {"type": "string", "pattern": "^asset://"},
        "window": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width": {"type": "integer", "minimum": 320, "maximum": 16384},
            "height": {"type": "integer", "minimum": 240, "maximum": 16384},
            "mode": {"enum": ["windowed", "borderless", "fullscreen"]}
          }
        },
        "android": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "orientation": {
              "enum": ["unspecified", "portrait", "landscape", "portrait_sensor", "landscape_sensor"]
            },
            "min_sdk": {"type": "integer", "minimum": 26, "maximum": 36},
            "abis": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": ["arm64-v8a", "x86_64"]}
            },
            "permissions": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^android\\.permission\\.[A-Z0-9_]+$"
              }
            }
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^scene://"
          },
          "path": {
            "type": "string"
          }
        }
      }
    },
    "scripting": {
      "type": "object",
      "properties": {
        "language": { "type": "string" },
        "entry": { "type": "string", "pattern": "^script://" },
        "modules": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "input_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["input"],
        "additionalProperties": false,
        "properties": {
              "input": {"type": "string", "pattern": "^[a-z0-9_]+:.+"},
              "scale": {"type": "number", "minimum": -1, "maximum": 1},
              "vector": {"$ref": "#/$defs/vec2"},
              "deadzone": {"type": "number", "minimum": 0, "maximum": 0.99},
              "invert": {"type": "boolean"},
              "normalize": {"type": "boolean"},
              "player": {"type": "integer", "minimum": 0}
        }
      }
    },
    "vec2": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}],
      "minItems": 2,
      "maxItems": 2
    }
  }
}
