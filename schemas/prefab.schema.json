{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demiengine.local/schemas/prefab.schema.json",
  "title": "DemiEngine Prefab",
  "type": "object",
  "required": ["format_version", "id"],
  "anyOf": [
    { "required": ["entities"] },
    { "required": ["elements"] },
    { "required": ["instances"] }
  ],
  "additionalProperties": false,
  "properties": {
    "format_version": { "type": "integer", "minimum": 1 },
    "id": { "type": "string", "pattern": "^prefab://" },
    "name": { "type": "string" },
    "source_recipe": { "type": "object", "description": "Cooked prefab source retained for regeneration when authoring overrides change prepared geometry." },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "anyOf": [{ "required": ["components"] }, { "required": ["prefab"] }],
        "properties": {
          "children": {
            "type": "array",
            "items": { "$ref": "#/properties/entities/items" },
            "description": "Local child entities; transform parent is inferred without changing stable IDs."
          },
          "id": { "type": "string" },
          "name": { "type": "string" },
          "enabled": { "type": "boolean", "default": true },
          "persistent": { "type": "boolean", "default": false },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "layer": { "type": "string" },
          "prefab": { "type": "string", "pattern": "^prefab://" },
          "overrides": { "$ref": "#/$defs/instance/properties/overrides" },
          "components": { "$ref": "components.schema.json" }
        }
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" }
        }
      }
    },
    "instances": {
      "type": "array",
      "items": { "$ref": "#/$defs/instance" }
    }
  },
  "$defs": {
    "instance": {
      "type": "object",
      "required": ["id", "prefab"],
      "properties": {
        "id": { "type": "string" },
        "prefab": { "type": "string", "pattern": "^prefab://" },
        "overrides": {
          "type": "object",
          "description": "Entity keys accept an object or null; dotted entity.Component.field keys accept a field value. Targets must exist.",
          "patternProperties": {
            "^[^.]+$": { "type": ["object", "null"] }
          },
          "additionalProperties": true
        }
      }
    }
  }
}
