{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demiengine.local/schemas/asset.schema.json",
  "title": "DemiEngine Asset Manifest",
  "type": "object",
  "required": ["format_version", "id", "type", "source"],
  "additionalProperties": true,
  "properties": {
    "format_version": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^asset://"
    },
    "type": {
      "type": "string",
      "enum": ["Texture2D", "TextureAtlas2D", "SpriteMetadata2D", "Font2D", "FontAtlas2D", "Model3D", "AudioClip", "VideoClip", "DataAsset", "DataSchema", "NetworkContract", "Material", "Shader", "RenderTarget", "Tilemap2D", "Icon2D", "SvgTexture2D", "GifAnimation2D", "ImageAnimation2D"]
    },
    "source": {
      "type": "string"
    },
    "texture": {
      "type": "string"
    },
    "atlas": {
      "type": "string"
    },
    "settings": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "filter": {
          "type": "string",
          "enum": ["nearest", "bilinear", "trilinear"]
        },
        "wrap": {
          "type": "string",
          "enum": ["repeat", "clamp", "mirror"]
        },
        "mipmaps": {
          "type": "boolean"
        },
        "compression": {
          "type": "string"
        },
        "quality": {
          "type": "integer", "minimum": 0, "maximum": 100
        },
        "platform_overrides": {
          "type": "object",
          "propertyNames": {"enum": ["linux", "linux_server", "android"]},
          "additionalProperties": {
            "type": "object",
            "properties": {
              "compression": {"type": "string"},
              "quality": {"type": "integer", "minimum": 0, "maximum": 100},
              "mipmaps": {"type": "boolean"}
            }
          }
        },
        "sprites": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "source", "pivot"],
            "properties": {
              "id": {"type": "string", "pattern": "^asset://"},
              "source": {"type": "string", "pattern": "^asset://"},
              "rect": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0}},
              "pivot": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
              "border": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0}},
              "animation_tag": {"type": "string"}
            }
          }
        },
        "glyph_ranges": {
          "type": "array", "items": {"type": "string"}
        },
        "pixel_height": {
          "type": "number", "exclusiveMinimum": 0
        },
        "page_size": {
          "type": "integer", "minimum": 1, "maximum": 8192
        },
        "fallbacks": {
          "type": "array", "items": {"type": "string", "pattern": "^asset://"}
        },
        "padding": {
          "type": "integer", "minimum": 0
        },
        "bleed": {
          "type": "integer", "minimum": 0
        }
      }
    }
  }
}
