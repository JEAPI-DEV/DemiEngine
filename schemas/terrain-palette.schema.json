{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demiengine.local/schemas/terrain-palette.schema.json",
  "title": "DemiEngine Terrain Palette",
  "description": "Versioned surface-set binding and independent named placement rules. Native parsing also validates finite ranges, effective density capacity and cross-asset references.",
  "type": "object",
  "required": [
    "format_version",
    "name"
  ],
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "material_set"
      ]
    },
    {
      "required": [
        "placements"
      ]
    }
  ],
  "properties": {
    "format_version": {
      "const": 3
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "material_set": {
      "type": "string",
      "pattern": "^asset://.+"
    },
    "art_density": {
      "type": "number",
      "minimum": 0,
      "default": 1
    },
    "grass_density": {
      "type": "number",
      "minimum": 0,
      "default": 1
    },
    "tree_density": {
      "type": "number",
      "minimum": 0,
      "default": 1
    },
    "rock_density": {
      "type": "number",
      "minimum": 0,
      "default": 1
    },
    "placements": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9_-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "model",
            "collision"
          ],
          "not": {
            "required": [
              "prefab"
            ]
          },
          "properties": {
            "collision": {
              "const": "none"
            }
          }
        },
        {
          "required": [
            "prefab"
          ],
          "not": {
            "required": [
              "model"
            ]
          }
        }
      ],
      "properties": {
        "model": {
          "type": "string",
          "pattern": "^asset://.+"
        },
        "prefab": {
          "type": "string",
          "pattern": "^prefab://.+"
        },
        "density": {
          "type": "number",
          "minimum": 0,
          "default": 1
        },
        "candidate_spacing": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Advanced fixed candidate lattice step. Omitted derives spacing/2 for positive spacing, or 0.25 otherwise."
        },
        "category": {
          "enum": [
            "prop",
            "grass",
            "tree",
            "rock"
          ],
          "default": "prop"
        },
        "spacing": {
          "type": "number",
          "minimum": 0,
          "default": 0
        },
        "scale": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "maximum": 3.402823466e+38,
            "exclusiveMinimum": 0
          },
          "default": [
            1,
            1
          ]
        },
        "yaw": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": -360,
            "maximum": 360
          },
          "default": [
            0,
            360
          ]
        },
        "slope": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 90
          },
          "default": [
            0,
            90
          ]
        },
        "moisture": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "default": [
            0,
            1
          ]
        },
        "water_distance": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 3.402823466e+38
          },
          "default": [
            0,
            3.402823466e+38
          ]
        },
        "biomes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "collision": {
          "enum": [
            "none",
            "static",
            "trigger"
          ],
          "default": "static"
        },
        "cluster": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 16
            },
            "strength": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0
            }
          }
        }
      }
    }
  }
}
