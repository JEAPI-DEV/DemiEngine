{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demiengine.local/schemas/terrain-source.schema.json",
  "title": "DemiEngine Terrain Source",
  "type": "object",
  "required": ["format_version", "id", "recipe"],
  "additionalProperties": false,
  "properties": {
    "format_version": {"const": 1},
    "id": {"type": "string", "pattern": "^asset://.+"},
    "name": {"type": "string"},
    "recipe": {
      "type": "object",
      "required": ["format_version"],
      "properties": {
        "format_version": {"const": 1},
        "landforms": {"type": "object", "propertyNames": {"minLength": 1}, "additionalProperties": {"$ref": "#/$defs/landform"}},
        "graph": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "format_version": {
              "const": 1
            },
            "output": {
              "type": "string"
            },
            "links": {
              "type": "array"
            },
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "type"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "parameters": {
                    "type": "object"
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "const": "noise"
                        }
                      },
                      "required": [
                        "type"
                      ]
                    },
                    "then": {
                      "properties": {
                        "parameters": {
                          "$ref": "#/$defs/noiseParameters"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "const": "path_distance_mask"
                        }
                      },
                      "required": [
                        "type"
                      ]
                    },
                    "then": {
                      "properties": {
                        "parameters": {
                          "$ref": "#/$defs/pathDistanceParameters"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {"type": {"const": "polygon_mask"}},
                      "required": ["type"]
                    },
                    "then": {
                      "properties": {
                        "parameters": {"$ref": "#/$defs/polygonMaskParameters"}
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "const": "river_route"
                        }
                      },
                      "required": [
                        "type"
                      ]
                    },
                    "then": {
                      "properties": {
                        "parameters": {
                          "$ref": "#/$defs/riverRouteParameters"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "const": "water"
                        }
                      },
                      "required": [
                        "type"
                      ]
                    },
                    "then": {
                      "properties": {
                        "parameters": {
                          "$ref": "#/$defs/waterNodeParameters"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "const": "water_edit"
                        }
                      },
                      "required": [
                        "type"
                      ]
                    },
                    "then": {
                      "properties": {
                        "parameters": {
                          "$ref": "#/$defs/waterEditParameters"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "const": "basin_water"
                        }
                      },
                      "required": [
                        "type"
                      ]
                    },
                    "then": {
                      "properties": {
                        "parameters": {
                          "$ref": "#/$defs/basinWaterParameters"
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "biomes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "material": {"type": "string", "pattern": "^(asset://.+)?$"},
              "texture_scale": {"type": "number", "exclusiveMinimum": 0, "default": 1},
              "allow_snow": {"type": "boolean", "default": true}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "landform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_height": {
          "type": "number",
          "default": 0,
          "maximum": 3.4028234663852886e+38,
          "minimum": -3.4028234663852886e+38
        },
        "height_variation": {
          "type": "number",
          "default": 8,
          "maximum": 3.4028234663852886e+38,
          "minimum": 0
        },
        "feature_size": {
          "type": "number",
          "default": 32,
          "maximum": 3.4028234663852886e+38,
          "exclusiveMinimum": 0
        },
        "roughness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        },
        "octaves": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "default": 4
        },
        "profile": {
          "type": "string",
          "enum": [
            "fbm",
            "ridged"
          ],
          "default": "fbm"
        },
        "warp_amplitude": {
          "type": "number",
          "default": 0,
          "maximum": 3.4028234663852886e+38,
          "minimum": 0
        },
        "warp_feature_size": {
          "type": "number",
          "default": 128,
          "maximum": 3.4028234663852886e+38,
          "exclusiveMinimum": 0
        },
        "stretch": {
          "type": "number",
          "default": 1,
          "maximum": 3.4028234663852886e+38,
          "exclusiveMinimum": 0
        },
        "heading": {
          "type": "number",
          "default": 0,
          "maximum": 3.4028234663852886e+38,
          "minimum": -3.4028234663852886e+38
        }
      }
    },
    "noiseParameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_height": {
          "$ref": "#/$defs/landform/properties/base_height"
        },
        "height_variation": {
          "$ref": "#/$defs/landform/properties/height_variation"
        },
        "feature_size": {
          "$ref": "#/$defs/landform/properties/feature_size"
        },
        "roughness": {
          "$ref": "#/$defs/landform/properties/roughness"
        },
        "octaves": {
          "$ref": "#/$defs/landform/properties/octaves"
        },
        "profile": {
          "$ref": "#/$defs/landform/properties/profile"
        },
        "warp_amplitude": {
          "$ref": "#/$defs/landform/properties/warp_amplitude"
        },
        "warp_feature_size": {
          "$ref": "#/$defs/landform/properties/warp_feature_size"
        },
        "stretch": {
          "$ref": "#/$defs/landform/properties/stretch"
        },
        "heading": {
          "$ref": "#/$defs/landform/properties/heading"
        },
        "seed_offset": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647,
          "default": 0
        }
      }
    },
    "pathDistanceParameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "points": {
          "type": "array",
          "minItems": 2,
          "default": [
            [
              0,
              0
            ],
            [
              0,
              100
            ]
          ],
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": -3.4028234663852886e+38,
              "maximum": 3.4028234663852886e+38
            }
          }
        },
        "width": {
          "type": "number",
          "default": 20,
          "minimum": 0
        },
        "falloff": {
          "type": "number",
          "default": 40,
          "minimum": 0
        }
      }
    },
    "polygonMaskParameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "points": {
          "type": "array",
          "minItems": 3,
          "default": [
            [
              0,
              0
            ],
            [
              100,
              0
            ],
            [
              100,
              100
            ],
            [
              0,
              100
            ]
          ],
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": -3.4028234663852886e+38,
              "maximum": 3.4028234663852886e+38
            }
          },
          "description": "At least three noncollinear terrain-local X/Z pairs. Closes automatically; repeated points and either winding are accepted."
        },
        "falloff": {
          "type": "number",
          "default": 20,
          "minimum": 0
        }
      }
    },
    "riverRouteParameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_x": {
          "type": "number",
          "minimum": -3.4028234663852886e+38,
          "maximum": 3.4028234663852886e+38,
          "default": 64
        },
        "source_z": {
          "type": "number",
          "minimum": -3.4028234663852886e+38,
          "maximum": 3.4028234663852886e+38,
          "default": 64
        },
        "channel_width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3.4028234663852886e+38,
          "default": 4
        },
        "channel_depth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3.4028234663852886e+38,
          "default": 2
        },
        "water_depth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3.4028234663852886e+38,
          "default": 1,
          "description": "No greater than channel_depth; native graph validation enforces this relation."
        }
      }
    },
    "waterNodeParameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "lake",
            "ocean",
            "river"
          ],
          "default": "lake"
        },
        "level": {
          "type": "number",
          "minimum": -3.4028234663852886e+38,
          "maximum": 3.4028234663852886e+38,
          "default": 0
        },
        "center_x": {
          "type": "number",
          "minimum": -3.4028234663852886e+38,
          "maximum": 3.4028234663852886e+38,
          "default": 64
        },
        "center_z": {
          "type": "number",
          "minimum": -3.4028234663852886e+38,
          "maximum": 3.4028234663852886e+38,
          "default": 64
        },
        "radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 3.4028234663852886e+38,
          "default": 20
        },
        "river_width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3.4028234663852886e+38,
          "default": 4
        },
        "river_surface_mode": {
          "type": "string",
          "enum": [
            "level",
            "follow_bed"
          ],
          "default": "level"
        },
        "river_depth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3.4028234663852886e+38,
          "default": 1
        },
        "river_path_interpolation": {
          "type": "string",
          "enum": ["linear", "catmull_rom"],
          "default": "linear"
        },
        "river_curve_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "default": 8
        },
        "river_path": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": -3.4028234663852886e+38,
              "maximum": 3.4028234663852886e+38
            }
          }
        },
        "shallow_color": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "deep_color": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "absorption_distance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3.4028234663852886e+38,
          "default": 3
        },
        "roughness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.12
        },
        "flow_speed": {
          "type": "number",
          "minimum": 0,
          "maximum": 3.4028234663852886e+38,
          "default": 0
        },
        "flow_direction": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": -3.4028234663852886e+38,
            "maximum": 3.4028234663852886e+38
          },
          "default": [
            1,
            0
          ]
        },
        "wave_amplitude": {
          "type": "number",
          "minimum": 0,
          "maximum": 3.4028234663852886e+38,
          "default": 0.05
        },
        "wave_length": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3.4028234663852886e+38,
          "default": 2
        },
        "wave_speed": {
          "type": "number",
          "minimum": 0,
          "maximum": 3.4028234663852886e+38,
          "default": 0.5
        },
        "normal_strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 3.4028234663852886e+38,
          "default": 1
        },
        "foam_width": {
          "type": "number",
          "minimum": 0,
          "maximum": 3.4028234663852886e+38,
          "default": 0.5
        },
        "foam_strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        },
        "foam_color": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "default": [
            1,
            1,
            1,
            1
          ]
        },
        "boundary": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": -3.4028234663852886e+38,
              "maximum": 3.4028234663852886e+38
            }
          },
          "anyOf": [
            {
              "maxItems": 0
            },
            {
              "minItems": 3
            }
          ],
          "default": []
        },
        "shoreline_softening": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "waterEditParameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "excluded_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        },
        "overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "dependentRequired": {
              "river_path_interpolation": ["river_path"],
              "river_curve_steps": ["river_path"]
            },
            "additionalProperties": false,
            "properties": {
              "kind": {
                "$ref": "#/$defs/waterNodeParameters/properties/kind"
              },
              "level": {
                "$ref": "#/$defs/waterNodeParameters/properties/level"
              },
              "center_x": {
                "$ref": "#/$defs/waterNodeParameters/properties/center_x"
              },
              "center_z": {
                "$ref": "#/$defs/waterNodeParameters/properties/center_z"
              },
              "radius": {
                "$ref": "#/$defs/waterNodeParameters/properties/radius"
              },
              "river_width": {
                "$ref": "#/$defs/waterNodeParameters/properties/river_width"
              },
              "river_surface_mode": {
                "$ref": "#/$defs/waterNodeParameters/properties/river_surface_mode"
              },
              "river_depth": {
                "$ref": "#/$defs/waterNodeParameters/properties/river_depth"
              },
              "river_path_interpolation": {
                "$ref": "#/$defs/waterNodeParameters/properties/river_path_interpolation"
              },
              "river_curve_steps": {
                "$ref": "#/$defs/waterNodeParameters/properties/river_curve_steps"
              },
              "river_path": {
                "$ref": "#/$defs/waterNodeParameters/properties/river_path"
              },
              "shallow_color": {
                "$ref": "#/$defs/waterNodeParameters/properties/shallow_color"
              },
              "deep_color": {
                "$ref": "#/$defs/waterNodeParameters/properties/deep_color"
              },
              "absorption_distance": {
                "$ref": "#/$defs/waterNodeParameters/properties/absorption_distance"
              },
              "roughness": {
                "$ref": "#/$defs/waterNodeParameters/properties/roughness"
              },
              "flow_speed": {
                "$ref": "#/$defs/waterNodeParameters/properties/flow_speed"
              },
              "flow_direction": {
                "$ref": "#/$defs/waterNodeParameters/properties/flow_direction"
              },
              "wave_amplitude": {
                "$ref": "#/$defs/waterNodeParameters/properties/wave_amplitude"
              },
              "wave_length": {
                "$ref": "#/$defs/waterNodeParameters/properties/wave_length"
              },
              "wave_speed": {
                "$ref": "#/$defs/waterNodeParameters/properties/wave_speed"
              },
              "normal_strength": {
                "$ref": "#/$defs/waterNodeParameters/properties/normal_strength"
              },
              "foam_width": {
                "$ref": "#/$defs/waterNodeParameters/properties/foam_width"
              },
              "foam_strength": {
                "$ref": "#/$defs/waterNodeParameters/properties/foam_strength"
              },
              "foam_color": {
                "$ref": "#/$defs/waterNodeParameters/properties/foam_color"
              },
              "boundary": {
                "$ref": "#/$defs/waterNodeParameters/properties/boundary"
              },
              "shoreline_softening": {
                "$ref": "#/$defs/waterNodeParameters/properties/shoreline_softening"
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "default": []
        }
      }
    },
    "basinWaterParameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum_depth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3.4028234663852886e+38,
          "default": 1
        },
        "minimum_area": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3.4028234663852886e+38,
          "default": 16
        },
        "maximum_bodies": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "default": 16
        },
        "level_offset": {
          "type": "number",
          "minimum": -3.4028234663852886e+38,
          "maximum": 0,
          "default": 0
        }
      }
    }
  }
}
