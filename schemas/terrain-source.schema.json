{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demiengine.local/schemas/terrain-source.schema.json",
  "title": "DemiEngine Terrain Source",
  "type": "object",
  "required": ["format_version", "id", "recipe"],
  "additionalProperties": false,
  "properties": {
    "format_version": {"const": 1},
    "id": {"type": "string", "pattern": "^asset://.+"},
    "name": {"type": "string"},
    "recipe": {"type": "object", "required": ["format_version"]}
  }
}
