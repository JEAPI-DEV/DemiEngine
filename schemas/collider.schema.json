{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demiengine.local/schemas/collider.schema.json",
  "title": "DemiEngine Collider Shape",
  "type": "object",
  "required": ["format_version", "shape"],
  "properties": {
    "format_version": { "type": "integer", "const": 1 },
    "shape": { "enum": ["convex_hull", "compound"] },
    "points": { "$ref": "#/$defs/points" },
    "fracture": {
      "type": "object", "required": ["bonds"], "additionalProperties": false,
      "description": "Optional connected fracture graph over compound part IDs. Does not enable runtime destruction by itself.",
      "properties": {
        "anchors": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/localId" } },
        "bonds": {
          "type": "array", "maxItems": 2048,
          "items": {
            "type": "object", "required": ["id", "parts"], "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/localId" },
              "parts": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/localId" } },
              "health": { "type": "number", "exclusiveMinimum": 0, "default": 1 }
            }
          }
        }
      }
    },
    "parts": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "required": ["id", "points"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
          "points": { "$ref": "#/$defs/points" },
          "density": { "type": "number", "minimum": 0.001, "maximum": 1000000, "default": 1000, "description": "Mass-distribution density in kg/m^3; Rigidbody3D mass sets the total." }
        }
      }
    }
  },
  "oneOf": [
    { "properties": { "shape": { "const": "convex_hull" } }, "required": ["points"], "not": { "anyOf": [{ "required": ["parts"] }, { "required": ["fracture"] }] } },
    { "properties": { "shape": { "const": "compound" } }, "required": ["parts"], "not": { "required": ["points"] } }
  ],
  "$defs": {
    "localId": { "type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
    "points": {
      "type": "array", "minItems": 4, "maxItems": 256,
      "description": "Finite local-space points with nonzero hull volume; geometric validation is performed by the asset loader.",
      "items": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } }
    }
  }
}
