{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demiengine.local/schemas/engine-extension.schema.json",
  "title": "DemiEngine Package Extension Registration",
  "type": "object",
  "required": ["format_version", "id", "kind", "entry", "platforms"],
  "additionalProperties": false,
  "properties": {
    "format_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "kind": {"type": "string", "enum": ["asset_importer", "asset_handler"]},
    "entry": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
    "platforms": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["linux", "linux_server", "android"]}
    },
    "version": {"type": "integer", "minimum": 1},
    "settings_schema_version": {"type": "integer", "minimum": 1},
    "supported_extensions": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^\\.[a-z0-9]+$"}
    },
    "asset_types": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "output_types": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "settings_schema": {"type": "object"},
    "thread_safe": {"type": "boolean"}
  }
}
