{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demiengine.local/schemas/texture-atlas.schema.json",
  "title": "DemiEngine Texture Atlas Descriptor",
  "type": "object",
  "required": ["format_version", "sprites"],
  "additionalProperties": false,
  "properties": {
    "format_version": {"const": 1},
    "page_width": {"type": "integer", "minimum": 1, "maximum": 8192},
    "page_height": {"type": "integer", "minimum": 1, "maximum": 8192},
    "padding": {"type": "integer", "minimum": 0},
    "bleed": {"type": "integer", "minimum": 0},
    "sprites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^asset://"},
          "source": {"type": "string", "pattern": "^asset://"},
          "pivot": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
          "border": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0}},
          "animation_tag": {"type": "string"}
        }
      }
    }
  }
}
