{
  "format_version": 1,
  "name": "Minimal 2D Android",
  "main_scene": "scene://minimal_2d_android/menu",
  "scenes": [
    {
      "id": "scene://minimal_2d_android/menu",
      "path": "scenes/menu.scene.json"
    },
    {
      "id": "scene://minimal_2d_android/platformer",
      "path": "scenes/platformer.scene.json"
    },
    {
      "id": "scene://minimal_2d_android/spiral",
      "path": "scenes/spiral.scene.json"
    }
  ],
  "input": {
    "actions": {
      "move": {
        "type": "axis1d",
        "bindings": [
          {"input": "a", "scale": -1},
          {"input": "left", "scale": -1},
          {"input": "d", "scale": 1},
          {"input": "right", "scale": 1},
          {"input": "gamepad:axis:left_x", "deadzone": 0.18},
          {"input": "virtual:move"}
        ]
      },
      "jump": {
        "type": "button",
        "bindings": [
          "space",
          "w",
          "up",
          "gamepad:south",
          "virtual:jump"
        ]
      }
    }
  },
  "scripting": {
    "language": "lua54",
    "modules": [
      "main_menu",
      "menu.actions",
      "menu.network",
      "network_lobby",
      "network_replication",
      "player_colors"
    ]
  }
}
