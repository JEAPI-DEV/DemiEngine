{
  "format_version": 1,
  "name": "Minimal 2D Android",
  "main_scene": "scene://minimal_2d_android/menu",
  "scenes": [
    {
      "id": "scene://minimal_2d_android/menu",
      "path": "scenes/menu.scene.json"
    },
    {
      "id": "scene://minimal_2d_android/platformer",
      "path": "scenes/platformer.scene.json"
    },
    {
      "id": "scene://minimal_2d_android/spiral",
      "path": "scenes/spiral.scene.json"
    }
  ],
  "input": {
    "actions": {
      "move": {
        "type": "axis1d",
        "bindings": [
          {
            "input": "key:a",
            "scale": -1
          },
          {
            "input": "key:left",
            "scale": -1
          },
          {
            "input": "key:d",
            "scale": 1
          },
          {
            "input": "key:right",
            "scale": 1
          },
          {
            "input": "gamepad:axis:left_x",
            "deadzone": 0.18
          },
          {
            "input": "virtual:move"
          }
        ],
        "context": "gameplay"
      },
      "jump": {
        "type": "button",
        "bindings": [
          {
            "input": "key:space"
          },
          {
            "input": "key:w"
          },
          {
            "input": "key:up"
          },
          {
            "input": "gamepad:south"
          },
          {
            "input": "virtual:jump"
          }
        ],
        "context": "gameplay"
      }
    }
  },
  "scripting": {
    "language": "lua54",
    "modules": [
      "main_menu",
      "menu.actions",
      "menu.network",
      "network_lobby",
      "network_replication",
      "player_colors"
    ]
  }
}
