{
  "format_version": 1,
  "name": "Isometric Base Builder",
  "package_registry": "../../packages",
  "packages": {
    "demi.gameplay.health": "^1.0.0"
  },
  "main_scene": "scene://isometric_base_builder/village",
  "scenes": [
    {
      "id": "scene://isometric_base_builder/village",
      "path": "scenes/village.scene.json"
    }
  ],
  "gameplay_model": {
    "projection": "isometric_2d",
    "physics": "box2d"
  },
  "simulation": {
    "fixed_timestep": 0.016666667,
    "random_seed": 6006
  },
  "debug": {
    "grid": false,
    "entity_ids": false,
    "draw_order": false
  },
  "input": {
    "actions": {
      "build_arrow": {
        "type": "button",
        "context": "gameplay",
        "bindings": [
          {
            "input": "key:1"
          }
        ]
      },
      "build_wizard": {
        "type": "button",
        "context": "gameplay",
        "bindings": [
          {
            "input": "key:2"
          }
        ]
      },
      "start_wave": {
        "type": "button",
        "context": "gameplay",
        "bindings": [
          {
            "input": "key:space"
          }
        ]
      },
      "cancel": {
        "type": "button",
        "context": "gameplay",
        "bindings": [
          {
            "input": "key:escape"
          }
        ]
      },
      "save": {
        "type": "button",
        "context": "gameplay",
        "bindings": [
          {
            "input": "key:s"
          }
        ]
      },
      "load": {
        "type": "button",
        "context": "gameplay",
        "bindings": [
          {
            "input": "key:l"
          }
        ]
      },
      "tower_upgrade": {
        "type": "button",
        "context": "gameplay",
        "bindings": [
          {
            "input": "key:u"
          }
        ]
      },
      "tower_destroy": {
        "type": "button",
        "context": "gameplay",
        "bindings": [
          {
            "input": "key:delete"
          }
        ]
      },
      "upgrade_range": {
        "type": "button",
        "context": "gameplay",
        "bindings": [
          {
            "input": "key:r"
          }
        ]
      },
      "upgrade_power": {
        "type": "button",
        "context": "gameplay",
        "bindings": [
          {
            "input": "key:p"
          }
        ]
      }
    }
  },
  "scripting": {
    "language": "lua54",
    "modules": [
      "game.actions"
    ]
  }
}
