      "fire": {
        "type": "button",
        "context": "gameplay",
        "bindings": [
          {
            "input": "key:f"
          },
          {
            "input": "mouse:left"
          },
          {
            "input": "gamepad:south"
          }
        ]
      },
      "jump": {
        "type": "button",
        "context": "gameplay",
        "bindings": [
          {
            "input": "key:space"
          }
        ]
      }
    }
  },
  "scenes": [
    {
      "id": "scene://minimal_3d/main"
    }
  ],
  "scripting": {
    "language": "lua54",
    "modules": []
