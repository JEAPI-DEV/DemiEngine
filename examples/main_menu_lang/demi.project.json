{
  "format_version": 1,
  "name": "Main Menu Languages",
  "package_registry": "../../packages",
  "packages": {
    "demi.ui.language_file": "^1.0.0"
  },
  "main_scene": "scene://main_menu_lang/main",
  "scenes": [
    {
      "id": "scene://main_menu_lang/main"
    }
  ],
  "assets": [
    "asset://language/en"
  ],
  "build": {
    "application_id": "dev.jeapi.demi.main_menu_lang",
    "display_name": "Main Menu Languages",
    "executable_name": "main_menu_lang",
    "version_name": "1.0.0",
    "version_code": 1,
    "window": {
      "width": 960,
      "height": 540,
      "mode": "windowed"
    },
    "android": {
      "orientation": "landscape",
      "min_sdk": 26,
      "abis": [
        "arm64-v8a"
      ],
      "permissions": []
    }
  },
  "gameplay_model": {
    "projection": "2d",
    "physics": "box2d"
  },
  "simulation": {
    "fixed_timestep": 0.016666667,
    "random_seed": 1201
  },
  "input": {
    "actions": {
      "language_english": {
        "type": "button",
        "context": "menu",
        "bindings": [
          {
            "input": "key:1"
          }
        ]
      },
      "language_german": {
        "type": "button",
        "context": "menu",
        "bindings": [
          {
            "input": "key:2"
          }
        ]
      }
    }
  },
  "scripting": {
    "language": "lua54"
  }
}
