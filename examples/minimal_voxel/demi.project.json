{
  "format_version": 1,
  "name": "Minimal Voxel",
  "display": {
    "vsync": false
  },
  "main_scene": "scene://minimal_voxel/main",
  "input": {
    "presets": [
      "move_3d"
    ],
    "actions": {
      "move_vertical": {
        "type": "axis1d",
        "context": "gameplay",
        "bindings": [
          {
            "input": "key:left shift",
            "scale": -1.0
          },
          {
            "input": "key:space",
            "scale": 1.0
          }
        ]
      },
      "sprint": {
        "type": "button",
        "context": "gameplay",
        "bindings": [
          {
            "input": "key:left ctrl"
          }
        ]
      },
      "jump": {
        "type": "button",
        "context": "gameplay",
        "bindings": [
          {
            "input": "key:space"
          }
        ]
      },
      "pause": {
        "type": "button",
        "context": "gameplay",
        "bindings": [
          {
            "input": "key:escape"
          }
        ]
      },
      "toggle_fly": {
        "type": "button",
        "context": "gameplay",
        "bindings": [
          {
            "input": "key:f"
          }
        ]
      },
      "inventory": {
        "type": "button",
        "context": "gameplay",
        "bindings": [
          {
            "input": "key:e"
          }
        ]
      }
    }
  },
  "scenes": [
    {
      "id": "scene://minimal_voxel/main"
    }
  ],
  "assets": [
    "asset://materials/first_person",
    "asset://materials/voxel_terrain"
  ],
  "scripting": {
    "language": "lua54",
    "entry": "script://scripts/worldgen.lua",
    "modules": []
  }
}
