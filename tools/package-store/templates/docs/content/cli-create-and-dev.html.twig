<table>
  <thead><tr><th>Goal</th><th>Command</th></tr></thead>
  <tbody>
    <tr><td>See available templates</td><td><code>demi new --list</code></td></tr>
    <tr><td>Create Skyforge</td><td><code>demi new games/my_game --template &lt;id&gt; --name "Skyforge"</code></td></tr>
    <tr><td>Check the machine</td><td><code>demi doctor --project games/my_game</code></td></tr>
    <tr><td>Edit with live reload</td><td><code>demi dev --project games/my_game</code></td></tr>
    <tr><td>Edit visually</td><td><code>demi editor --project games/my_game</code></td></tr>
    <tr><td>Play on the desktop</td><td><code>demi run --project games/my_game</code></td></tr>
    <tr><td>Play on a phone</td><td><code>demi run android --project games/my_game --serial &lt;device&gt;</code></td></tr>
  </tbody>
</table>
