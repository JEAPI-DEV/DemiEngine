{
  "name": "demiengine/package-store",
  "description": "Free package and asset catalog for DemiEngine.",
  "type": "project",
  "license": "BSD-3-Clause",
  "require": {
    "php": ">=8.2",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "symfony/framework-bundle": "7.4.*",
    "symfony/console": "7.4.*",
    "symfony/yaml": "7.4.*",
    "symfony/twig-bundle": "7.4.*",
    "symfony/filesystem": "7.4.*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "test": "php tests/run.php"
  }
}
